{
  "name": "saucebase/coming-soon",
  "description": "A configurable coming soon page and site access gate for Saucebase.",
  "type": "saucebase-module",
  "license": "MIT",
  "version": "v0.1.1",
  "authors": [
    {
      "name": "Saucebase",
      "email": "hello@saucebase.dev"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Modules\\ComingSoon\\Providers\\ComingSoonServiceProvider"
      ]
    },
    "saucebase": {
      "frameworks": [
        "vue",
        "react"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\ComingSoon\\": "src/",
      "Modules\\ComingSoon\\Tests\\Support\\": "tests/Support/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\ComingSoon\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "require": {
    "saucebase/core": "^1.13"
  }
}
